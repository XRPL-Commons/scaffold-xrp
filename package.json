{
  "name": "scaffold-xrp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write .",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "pnpm": ">=10.26.0"
  },
  "packageManager": "pnpm@10.34.6",
  "overrides": {
    "esbuild": "0.28.2",
    "postcss-selector-parser": "7.1.6"
  }
}
