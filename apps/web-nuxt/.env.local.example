# XRPL Connect configuration
# Copy this file to .env.local and fill in the credentials you need.

# Xaman API key
# Get your API key from https://apps.xumm.dev/
NUXT_PUBLIC_XAMAN_API_KEY=

# WalletConnect Project ID
# Get your project ID from https://cloud.walletconnect.com
NUXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Supported values: testnet (default) or devnet
NUXT_PUBLIC_DEFAULT_NETWORK=testnet
